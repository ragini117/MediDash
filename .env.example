# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_APP_TITLE=MultiDisease Tracker

# Backend API Endpoints - Disease Detection & Analysis
VITE_BRAIN_DETECTION_API=http://localhost:5001/predict/brain
VITE_LUNG_DETECTION_API=http://localhost:5005/predict/lung
VITE_CHATBOT_API=http://localhost:5004/ask
VITE_HOSPITAL_API=http://localhost:5005/api/hospitals
VITE_INSURANCE_API=http://localhost:5005/api/insurances
VITE_NEWS_API=http://localhost:5006/api/news
VITE_GUIDANCE_API=http://localhost:8000/get-guidance

# LangChain Configuration (for Chatbot)
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_environment

# MySQL Database Configuration (for Hospital Backend)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=multidisease_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Python Path
PYTHONPATH=.
